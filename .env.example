# TEMPLATE ONLY. Copy locally to .env; NEVER include the populated .env in a ZIP.
# No network call occurs until live score_exams.py is run.
SCORING_PROVIDER=azure

# Azure resource root or URL already ending /openai/v1/.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_DEPLOYMENT=REPLACE_ME_WITH_DEPLOYMENT_NAME
AZURE_OPENAI_REASONING_EFFORT=high
AZURE_OPENAI_MAX_OUTPUT_TOKENS=30000
AZURE_OPENAI_TIMEOUT_SECONDS=900

# OPTIONAL direct OpenAI adapter. Not used while SCORING_PROVIDER=azure.
# SCORING_PROVIDER=openai
# OPENAI_API_KEY=REPLACE_ME
# OPENAI_MODEL=REPLACE_ME_WITH_MODEL_NAME
# OPENAI_REASONING_EFFORT=high
# OPENAI_MAX_OUTPUT_TOKENS=30000
# OPENAI_TIMEOUT_SECONDS=900

# SDK retries for transient errors; not retries of incorrect grading decisions.
SCORING_MAX_RETRIES=2

# Blank omits input_file.detail, preserving the baseline request shape.
# Set high only after confirming support/cost with your deployment.
SCORING_PDF_DETAIL=
# Blank *_REASONING_EFFORT omits the reasoning parameter for incompatible models.
# Credentials exported in the shell take precedence over this local file.
